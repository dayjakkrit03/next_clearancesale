generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client/interlink"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_INTERLINK")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model category {
  category_id          Int      @id @default(autoincrement())
  category_name        String   @db.VarChar(200)
  category_number      Int
  category_keyword     String?  @db.Text
  category_title       String?  @db.Text
  category_description String?  @db.Text
  category_color       String?  @db.VarChar(7)
  category_picture     String?  @db.VarChar(200)
  category_status      Int      @default(1)
  users_action         Int
  created_at           DateTime @default(now()) @db.Timestamp(0)
  updated_at           DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.Timestamp(0)
}

model more_pictures {
  mp_id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id      Int      @default(0)
  product_picture String   @db.Text
  create_date     DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.DateTime(0)
  create_name     String   @default("") @db.VarChar(250)
  update_date     DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.DateTime(0)
  update_name     String   @default("") @db.VarChar(250)
}

model part {
  part_id      Int      @id @default(autoincrement())
  category_id  Int
  sub_id       Int
  part_name    String   @db.VarChar(200)
  part_picture String?  @db.VarChar(200)
  part_color   String?  @db.VarChar(7)
  part_status  Int      @default(1)
  users_action Int
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.Timestamp(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model product {
  product_id          Int      @id @default(autoincrement())
  category_id         Int?     @default(0)
  sub_id              Int?     @default(0)
  part_id             Int?     @default(0)
  product_name        String?  @db.VarChar(255)
  product_brand       String?  @db.VarChar(255)
  product_description String?  @db.Text
  product_picture     String?  @db.Text
  product_sku         String?  @db.VarChar(255)
  product_file        String?  @db.Text
  product_filename    String?  @db.VarChar(255)
  product_price       Decimal? @db.Decimal(10, 2)
  product_new         Int?     @default(0)
  product_best        Int?     @default(0)
  product_status      Int?     @default(1)
  users_action        Int?
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.Timestamp(0)
  product_uom         String?  @db.VarChar(10)
  /// This field was commented out because of an invalid name. Please provide a valid one that matches [a-zA-Z][a-zA-Z0-9_]*
  // 09 Boolean @default(true) @map("09")
  /// This field was commented out because of an invalid name. Please provide a valid one that matches [a-zA-Z][a-zA-Z0-9_]*
  /// This field was commented out because of an invalid name. Please provide a valid one that matches [a-zA-Z][a-zA-Z0-9_]*
  clearanceSales      Boolean? @default(false)
  clearanceQuantity   Int?     @default(0)
  clearancePrice      Decimal? @db.Decimal(10, 2)
  expo_status         Int?     @default(0) @db.TinyInt
  expo_price          Decimal? @default(0.00) @db.Decimal(10, 2)
  cat5e               Int?     @default(0) @db.TinyInt
  cat6                Int?     @default(0) @db.TinyInt
  tool_tester         Int?     @default(0) @db.TinyInt
}

model sub {
  sub_id          Int      @id @default(autoincrement())
  category_id     Int
  sub_name        String   @db.VarChar(255)
  sub_keyword     String?  @db.Text
  sub_title       String?  @db.Text
  sub_description String?  @db.Text
  sub_picture     String?  @db.VarChar(200)
  sub_color       String?  @db.VarChar(7)
  sub_status      Int      @default(1)
  users_action    Int
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(dbgenerated("'0000-00-00 00:00:00'")) @db.Timestamp(0)
}
